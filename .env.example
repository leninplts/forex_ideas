# =============================================================================
# Variables de entorno para Docker Compose
# Copiar a .env y llenar con tus valores reales:
#   cp .env.example .env
# =============================================================================

# --- VNC (acceso web al escritorio MT5) ---
VNC_USER=admin
VNC_PASSWORD=tu_password_vnc_aqui
VNC_PORT=3000

# --- MetaTrader 5 (credenciales del broker) ---
MT5_LOGIN=123456789
MT5_PASSWORD=tu_password_broker
MT5_SERVER=Exness-MT5Trial11

# --- Telegram (notificaciones, opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bot ---
BOT_MODE=demo
